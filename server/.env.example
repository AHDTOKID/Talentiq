# Copy to server/.env. Use your local MongoDB or a MongoDB Atlas URI.
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/talentiq
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# The seed script creates demo accounts only when you explicitly run npm run seed.
SEED_ADMIN_EMAIL=admin@talentiq.demo
SEED_ADMIN_PASSWORD=DemoAdmin123!
